generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ASSISTANT_DIRECTOR
  DIRECTOR
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  passwordHash String 
  role  Role   @default(MEMBER)
  tasks Task[]
}

model Event {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime
  venue     String
  createdAt DateTime @default(now())

  tasks       Task[]
  allocations EventEquipment[]
}

model Task {
  id        Int        @id @default(autoincrement())
  title     String
  dueDate   DateTime
  status    TaskStatus @default(TODO)
  eventId   Int
  ownerId   Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id])
  owner User  @relation(fields: [ownerId], references: [id])

  @@index([ownerId, dueDate])
}

model Equipment {
  id            Int    @id @default(autoincrement())
  name          String
  totalQuantity Int

  allocations EventEquipment[]
}

model EventEquipment {
  id          Int @id @default(autoincrement())
  eventId     Int
  equipmentId Int
  quantity    Int

  event     Event     @relation(fields: [eventId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([eventId, equipmentId])
}